{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hx-infrastructure.local/schemas/agent-result-envelope.schema.json",
  "title": "HX Agent Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "agent",
    "status",
    "knowledge_sources_reviewed",
    "scope_observed",
    "summary",
    "outputs",
    "validation",
    "error",
    "retry_count",
    "next_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "hx-agent-result/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["completed", "partial", "blocked", "failed"]
    },
    "knowledge_sources_reviewed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "identity"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "written"],
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "written": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "results", "independent_reviewer"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "result"],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": ["pass", "fail", "not-run"]
              },
              "evidence_ref": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "independent_reviewer": {
          "type": ["string", "null"]
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "retryable", "native_message", "partial_output_ref"],
          "properties": {
            "class": {
              "enum": [
                "transient",
                "format",
                "syntax",
                "knowledge",
                "permission",
                "security",
                "authority",
                "scope",
                "evidence",
                "concurrency",
                "unknown"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "native_message": {
              "type": ["string", "null"]
            },
            "partial_output_ref": {
              "type": ["string", "null"]
            }
          }
        }
      ]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "next_authority": {
      "enum": ["max", "claude", "agent-zero"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "results": {
                "minItems": 1
              },
              "independent_reviewer": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["blocked", "failed"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "retryable": {
                "const": true
              }
            },
            "required": ["retryable"]
          }
        },
        "required": ["error"]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "class": {
                "enum": ["transient", "format", "syntax"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retry_count": {
            "const": 1
          }
        },
        "required": ["retry_count"]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "class": {
                "enum": ["transient", "format", "syntax"]
              }
            }
          }
        }
      }
    }
  ]
}